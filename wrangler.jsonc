{
  "name": "spinthewheel",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wheel-db",
      "database_id": "5392b82d-2432-4f20-bf4a-2ca86db268fc"
    }
  ]
}
