{
  "name": "spinthewheel",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wheel-db",
      "database_id": "2d6df353-fa05-4f85-a4b6-ba6c91fc83c4"
    }
  ]
}
